{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coding Studio",
  "version": "0.1.0",
  "identifier": "ch.dossantos.codingstudio",
  "build": {
    "devUrl": "http://127.0.0.1:5199",
    "beforeDevCommand": {
      "script": "pnpm --dir web install --frozen-lockfile --prefer-offline && CS_GUIDE_DIR=\"$(pwd)/docs/guide\" pnpm --dir web dev",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "make web",
      "cwd": "../.."
    },
    "frontendDist": "../cs-app/web-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Auditable interview coding: segmentation, human and AI coding, arbitration",
    "copyright": "Alexandre Dos Santos Coelho",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
